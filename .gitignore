# ---- Gradle / 构建产物 ----
.gradle/
build/

# ---- 本机便携 JDK（约 300MB，仅供本机构建，不入库） ----
.tools/

# ---- 运行时配置（含明文相机密码，禁止提交） ----
backup-config.json
config.json

# ---- 运行时数据 ----
backups/
exports/

# ---- 发布用 fat jar（大体积二进制，不属于源码） ----
/jobx文件备份助手_*.jar

# ---- 发布用单文件 exe（内嵌 JRE，约 130MB，不入库） ----
/jobx文件备份助手_*.exe

# ---- Launcher 内嵌 JRE MSI（约 41MB）与 dotnet 构建产物 ----
#      payload/ 与 bin/obj 均由 bundle-exe-with-timestamp.sh 重新生成
launcher/*.msi
launcher/Launcher/bin/
launcher/Launcher/obj/
launcher/Launcher/payload/

# ---- Kimi 会话导出（可能含敏感信息） ----
kimi-export-*.md

# ---- IDE / 操作系统 ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
